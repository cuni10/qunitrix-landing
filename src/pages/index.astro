        <script>
            const items = document.querySelectorAll(".dock-item");
            const views = document.querySelectorAll(".view");

            // ─── WebGL Fluid Shader Background & Low Performance Detection ───
            function checkLowPerformanceMode() {
                // 1. URL parameter override: ?perf=low o ?perf=high
                try {
                    const params = new URLSearchParams(window.location.search);
                    const perf = params.get("perf");
                    if (perf === "high") {
                        return { isLowPerf: false, reason: "Forzado por ?perf=high" };
                    }
                    if (perf === "low") {
                        return { isLowPerf: true, reason: "Forzado por ?perf=low" };
                    }
                } catch (_) {}

                // 2. Accessibility: prefers-reduced-motion
                if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    return { isLowPerf: true, reason: "Preferencia de reducción de movimiento activa" };
                }

                // 3. Data saver mode
                if (navigator.connection && navigator.connection.saveData) {
                    return { isLowPerf: true, reason: "Modo ahorro de datos activo" };
                }

                // 4. Low CPU core count (<= 2 cores)
                if (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2) {
                    return { isLowPerf: true, reason: "Dispositivo de bajo rendimiento (<= 2 núcleos CPU)" };
                }

                // 5. Low Device RAM (<= 2GB)
                if (navigator.deviceMemory && navigator.deviceMemory <= 2) {
                    return { isLowPerf: true, reason: "Memoria RAM baja detectada (<= 2GB)" };
                }

                return { isLowPerf: false };
            }

            (function initShaderBackground() {
                const canvas = document.getElementById("shader-canvas-ANIMATION_12");
                if (!canvas) return;

                const lowPerfCheck = checkLowPerformanceMode();
                if (lowPerfCheck.isLowPerf) {
                    document.body.classList.add("low-perf");
                }

                function syncSize() {
                    const w = canvas.clientWidth || window.innerWidth || 1280;
                    const h = canvas.clientHeight || window.innerHeight || 720;
                    if (canvas.width !== w || canvas.height !== h) {
                        canvas.width = w;
                        canvas.height = h;
                    }
                }
                if (typeof ResizeObserver !== "undefined") {
                    new ResizeObserver(syncSize).observe(canvas);
                }
                syncSize();

                const gl = canvas.getContext("webgl") || canvas.getContext("experimental-webgl");
                if (!gl) {
                    document.body.classList.add("low-perf");
                    return;
                }

                const vs = `attribute vec2 a_position;
varying vec2 v_texCoord;
void main() {
  v_texCoord = a_position * 0.5 + 0.5;
  gl_Position = vec4(a_position, 0.0, 1.0);
}`;
                const fs = `precision highp float;
uniform vec2 u_resolution;
uniform float u_time;
uniform vec2 u_mouse;
varying vec2 v_texCoord;

// Simplex-esque smooth procedural fluid noise for liquid glass refraction
vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 permute(vec3 x) { return mod289(((x*34.0)+1.0)*x); }

float snoise(vec2 v) {
    const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
    vec2 i  = floor(v + dot(v, C.yy));
    vec2 x0 = v -   i + dot(i, C.xx);
    vec2 i1;
    i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    vec4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;
    i = mod289(i);
    vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
    vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
    m = m*m;
    m = m*m;
    vec3 x = 2.0 * fract(p * C.www) - 1.0;
    vec3 h = abs(x) - 0.5;
    vec3 ox = floor(x + 0.5);
    vec3 a0 = x - ox;
    m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
    vec3 g;
    g.x  = a0.x  * x0.x  + h.x  * x0.y;
    g.yz = a0.yz * x12.xz + h.yz * x12.yw;
    return 130.0 * dot(m, g);
}

void main() {
    vec2 st = gl_FragCoord.xy / u_resolution.xy;
    st.x *= u_resolution.x / u_resolution.y;

    vec2 mouse = u_mouse / u_resolution;
    vec2 mouseOffset = (mouse - 0.5) * 0.2;

    float t = u_time * 0.35;
    
    // Multi-octave flowing liquid caustics and fluid movement
    vec2 q = vec2(0.0);
    q.x = snoise(st * 1.5 + vec2(t * 0.2, t * 0.1) + mouseOffset);
    q.y = snoise(st * 1.5 + vec2(t * 0.15, -t * 0.25));

    vec2 r = vec2(0.0);
    r.x = snoise(st * 2.2 + q * 1.2 + vec2(1.7, 9.2) + 0.15 * t);
    r.y = snoise(st * 2.2 + q * 1.2 + vec2(8.3, 2.8) + 0.126 * t);

    float f = snoise(st * 1.8 + r * 1.4);

    // Deep luminous dark aesthetics with glowing lime/chartreuse #ceff00 caustics and cyan accents
    vec3 deepDark = vec3(0.04, 0.07, 0.08); // #080f10
    vec3 surfaceTeal = vec3(0.08, 0.14, 0.15); // subtle refraction
    vec3 limeGlow = vec3(0.81, 1.0, 0.0);    // #ceff00 vivid lime
    vec3 cyanMist = vec3(0.0, 0.85, 0.75);

    // Caustic light strands
    float caustic = pow(clamp(f * 0.5 + 0.5, 0.0, 1.0), 3.0);
    float causticRays = pow(clamp(snoise(st * 3.5 + r * 0.8 + t * 0.4) * 0.5 + 0.5, 0.0, 1.0), 4.0);

    vec3 col = mix(deepDark, surfaceTeal, clamp((f*f*4.0), 0.0, 1.0));
    col = mix(col, cyanMist * 0.6, clamp(length(q) * 0.4, 0.0, 1.0));
    col += limeGlow * (caustic * 0.45 + causticRays * 0.6);

    // Subtle dark vignette to keep typography legible
    vec2 uvNorm = gl_FragCoord.xy / u_resolution.xy;
    float vignette = uvNorm.x * uvNorm.y * (1.0 - uvNorm.x) * (1.0 - uvNorm.y);
    vignette = clamp(pow(16.0 * vignette, 0.25), 0.0, 1.0);
    col *= (0.65 + 0.35 * vignette);

    gl_FragColor = vec4(col, 1.0);
}`;
                function cs(type, src) {
                    const s = gl.createShader(type);
                    gl.shaderSource(s, src);
                    gl.compileShader(s);
                    return s;
                }
                const prog = gl.createProgram();
                gl.attachShader(prog, cs(gl.VERTEX_SHADER, vs));
                gl.attachShader(prog, cs(gl.FRAGMENT_SHADER, fs));
                gl.linkProgram(prog);
                gl.useProgram(prog);
                const buf = gl.createBuffer();
                gl.bindBuffer(gl.ARRAY_BUFFER, buf);
                gl.bufferData(
                    gl.ARRAY_BUFFER,
                    new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
                    gl.STATIC_DRAW,
                );
                const pos = gl.getAttribLocation(prog, "a_position");
                gl.enableVertexAttribArray(pos);
                gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);
                const uTime = gl.getUniformLocation(prog, "u_time");
                const uRes = gl.getUniformLocation(prog, "u_resolution");
                const uMouse = gl.getUniformLocation(prog, "u_mouse");

                let mouse = { x: canvas.width / 2, y: canvas.height / 2 };
                window.addEventListener("mousemove", (event) => {
                    const rect = canvas.getBoundingClientRect();
                    if (rect.width && rect.height) {
                        const nx = (event.clientX - rect.left) / rect.width;
                        const ny = 1.0 - (event.clientY - rect.top) / rect.height;
                        mouse.x = nx * canvas.width;
                        mouse.y = ny * canvas.height;
                    }
                });

                function render(t) {
                    if (typeof ResizeObserver === "undefined") syncSize();
                    gl.viewport(0, 0, canvas.width, canvas.height);
                    if (uTime) gl.uniform1f(uTime, t * 0.001);
                    if (uRes) gl.uniform2f(uRes, canvas.width, canvas.height);
                    if (uMouse) gl.uniform2f(uMouse, mouse.x, mouse.y);
                    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
                    if (!lowPerfCheck.isLowPerf) {
                        requestAnimationFrame(render);
                    }
                }
                render(0);
            })();

            const glassPanel = document.querySelector(".glass-panel");
            let dragState = null;
            let currentOffsetX = 0;
            let currentOffsetY = 0;

            function getPos(e) {
                return e.touches
                    ? { x: e.touches[0].clientX, y: e.touches[0].clientY }
                    : { x: e.clientX, y: e.clientY };
            }

            function clamp(val, min, max) {
                return Math.max(min, Math.min(val, max));
            }

            function updatePanelForView(target) {
                if (!glassPanel) return;
                if (target === "servicios") {
                    glassPanel.classList.add("mode-servicios");
                } else {
                    glassPanel.classList.remove("mode-servicios");
                }

                if (window.innerWidth <= 600) return;

                // Si ha sido arrastrado previamente, aseguramos que con el nuevo ancho no se desborde
                if (currentOffsetX !== 0 || currentOffsetY !== 0) {
                    const targetW = target === "servicios" ? 560 : 420;
                    const maxOffsetX = Math.max(0, (window.innerWidth * 0.85 - targetW / 2) - (window.innerWidth / 2));
                    const minOffsetX = Math.min(0, (window.innerWidth * 0.15 + targetW / 2) - (window.innerWidth / 2));
                    currentOffsetX = clamp(currentOffsetX, minOffsetX, maxOffsetX);
                    glassPanel.style.transform = `translate(calc(-50% + ${currentOffsetX}px), calc(-50% + ${currentOffsetY}px))`;
                }
            }

            function initPanel() {
                if (!glassPanel) return;
                if (window.innerWidth <= 600) {
                    glassPanel.style.transform = "";
                    return;
                }
                const isServicios = document.getElementById("view-servicios") && document.getElementById("view-servicios").classList.contains("active");
                if (isServicios) {
                    glassPanel.classList.add("mode-servicios");
                } else {
                    glassPanel.classList.remove("mode-servicios");
                }

                if (currentOffsetX !== 0 || currentOffsetY !== 0) {
                    const w = glassPanel.offsetWidth;
                    const maxOffsetX = Math.max(0, (window.innerWidth * 0.85 - w / 2) - (window.innerWidth / 2));
                    const minOffsetX = Math.min(0, (window.innerWidth * 0.15 + w / 2) - (window.innerWidth / 2));
                    currentOffsetX = clamp(currentOffsetX, minOffsetX, maxOffsetX);
                    glassPanel.style.transform = `translate(calc(-50% + ${currentOffsetX}px), calc(-50% + ${currentOffsetY}px))`;
                } else {
                    glassPanel.style.transform = "";
                }
            }

            function switchView(target) {
                if (target === "proyectos") target = "servicios";
                const targetBtn = document.querySelector(`.dock-item[data-view="${target}"]`);
                const targetView = document.getElementById("view-" + target);
                if (!targetBtn || !targetView) return;

                items.forEach((i) => i.classList.remove("active"));
                targetBtn.classList.add("active");

                views.forEach((v) => v.classList.remove("active"));
                targetView.classList.add("active");

                updatePanelForView(target);
            }

            items.forEach((item) => {
                item.addEventListener("click", () => {
                    const target = item.getAttribute("data-view");
                    switchView(target);
                });
            });

            if (window.location.hash) {
                const hash = window.location.hash.replace("#", "");
                const targetViewName = hash === "proyectos" ? "servicios" : hash;
                const targetBtn = document.querySelector(`.dock-item[data-view="${targetViewName}"]`);
                const targetView = document.getElementById("view-" + targetViewName);
                if (targetBtn && targetView) {
                    items.forEach((i) => i.classList.remove("active"));
                    targetBtn.classList.add("active");
                    views.forEach((v) => v.classList.remove("active"));
                    targetView.classList.add("active");
                }
            }

            initPanel();
            window.addEventListener("resize", initPanel);

            window.addEventListener("hashchange", () => {
                const hash = window.location.hash.replace("#", "");
                switchView(hash);
            });

            const pieces = document.querySelectorAll(".logo-piece");
            setTimeout(() => {
                pieces.forEach((p) => {
                    p.style.opacity = "1";
                    p.style.transform = "scale(1)";
                    p.style.animation = "none";
                });
            }, 1500);

            function applyDrag(e) {
                if (!dragState) return;
                const pos = getPos(e);
                let newOffsetX = dragState.startOffsetX + (pos.x - dragState.sx);
                let newOffsetY = dragState.startOffsetY + (pos.y - dragState.sy);
                const w = glassPanel.offsetWidth;
                const h = glassPanel.offsetHeight;
                const maxOffsetX = Math.max(0, (window.innerWidth * 0.85 - w / 2) - (window.innerWidth / 2));
                const minOffsetX = Math.min(0, (window.innerWidth * 0.15 + w / 2) - (window.innerWidth / 2));
                const maxOffsetY = Math.max(0, (window.innerHeight * 0.85 - h / 2) - (window.innerHeight / 2));
                const minOffsetY = Math.min(0, (window.innerHeight * 0.15 + h / 2) - (window.innerHeight / 2));
                currentOffsetX = clamp(newOffsetX, minOffsetX, maxOffsetX);
                currentOffsetY = clamp(newOffsetY, minOffsetY, maxOffsetY);
                glassPanel.style.transform = `translate(calc(-50% + ${currentOffsetX}px), calc(-50% + ${currentOffsetY}px))`;
            }

            glassPanel.addEventListener("mousedown", function (e) {
                if (window.innerWidth <= 600) return;
                if (e.target.closest(".dock-item, button, a, .project-card"))
                    return;
                glassPanel.classList.add("is-dragging");
                const pos = getPos(e);
                dragState = {
                    sx: pos.x,
                    sy: pos.y,
                    startOffsetX: currentOffsetX,
                    startOffsetY: currentOffsetY,
                };
                e.stopPropagation();
            });

            glassPanel.addEventListener(
                "touchstart",
                function (e) {
                    if (window.innerWidth <= 600) return;
                    if (
                        e.target.closest(".dock-item, button, a, .project-card")
                    )
                        return;
                    glassPanel.classList.add("is-dragging");
                    const pos = getPos(e);
                    dragState = {
                        sx: pos.x,
                        sy: pos.y,
                        startOffsetX: currentOffsetX,
                        startOffsetY: currentOffsetY,
                    };
                    e.stopPropagation();
                },
                { passive: false },
            );

            document.addEventListener("mousemove", applyDrag);
            document.addEventListener("mouseup", function () {
                dragState = null;
                glassPanel.classList.remove("is-dragging");
            });
            document.addEventListener("touchmove", applyDrag, { passive: false });

            document.addEventListener("touchend", function () {
                dragState = null;
                glassPanel.classList.remove("is-dragging");
            });
        </script>
    </body>
</html>
